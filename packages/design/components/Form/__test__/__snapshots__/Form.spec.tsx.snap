          <span
            class="bgm-editor__bbcode-tip__left"
          >
            使用 Ctrl+Enter 或 Alt+S 快速提交 |
             
          </span>
          <a
            class="bgm-link d_inline-block c_#0084b4 cursor_pointer [&:link,_&:visited,_&:active]:td_none hover:c_#02a3fb hover:td_underline"
            data-discover="true"
            href="/help/bbcode"
          >
            BBCode指南
          </a>
        </span>
      </div>
    </div>
  </form>
</div>
`;
